import math
"""
2520 is the smallest number that can be divided by each of the numbers from 1 to 10 without any remainder.
What is the smallest positive number that is evenly divisible (divisible with no remainder) by all of the numbers from 1 to 20?

ANSWER: 232792560
"""

# Time O(n*e^n), Space O(1)
def smallestEvenlyDivisibleToNBrute(n):
    num = 21
    evenlyDivisible = False
    
    while not evenlyDivisible:
        evenlyDivisible = True
        for i in range(2, n+1):
            if num % i != 0:
                num += 1
                evenlyDivisible = False
                break
    return num

# Time O(n^(3/2)), Space O(1)
def smallestEvenlyDivisibleToNCheckPrime(n):
    smallest = 1
    
    for i in range(2,n+1):
        if isPrime(i):
            highest = int(math.log(n,i))
            smallest *= i**highest
    return smallest

# Time O(sqrt(n)), Space O(1)
def isPrime(n):
    if n <= 1:
        return False

    for i in range(2, int(math.sqrt(n)) + 1):
        if n % i == 0:
            return False

    return True

# Time O(n log log n), Space O(n)
def smallestEvenlyDivisibleToNHavePrimes(n):
    smallest = 1
    primes = primesUpToN(n)
    
    for prime in primes:
        highest = int(math.log(n,prime))
        smallest *= prime**highest
    return smallest

# Time O(n log log n), Space O(n)
def primesUpToN(n):
    primes = []
    nums = [True] * (n+1)
    
    for p in range(2, n+1):
        if nums[p]:
            primes.append(p)
            for i in range(p*p, n+1, p):
                nums[i] = False

    return primes


print(smallestEvenlyDivisibleToNBrute(10))
print(smallestEvenlyDivisibleToNCheckPrime(10))
print(smallestEvenlyDivisibleToNHavePrimes(10))

print(smallestEvenlyDivisibleToNBrute(20))
print(smallestEvenlyDivisibleToNCheckPrime(20))
print(smallestEvenlyDivisibleToNHavePrimes(20))
