"""
Surprisingly, there are only three numbers that can be written as the sum of the fourth powers of their digits:

1634 = 1^4 + 6^4 + 3^4 + 4^4
8208 = 8^4 + 2^4 + 0^4 + 8^4
9474 = 9^4 + 4^4 + 7^4 + 4^4

As 1 = 1^4 is not a sum, it is not included.

The sum of these numbers is 1634 + 8208 + 9474 = 19316

Find the sum of all the numbers that can be written as the sum of the fifth powers of their digits.

ANSWER: 443839
"""

# Time: O(n * 9^n),  Space: O(1)
def digitNthPowersSum(n):
    if n <= 1 or 6 <= n:
        return 0
    
    total = 0
    limit = 6 * (9**n)
    
    for i in range(2, limit+1):
        powers = digitPowersSum(i, n)
        if i == powers:
            total += i
        
    return total

# Time: O(log n),  Space: O(1)
# Given n = num
def digitPowersSum(num, power):
    total = 0
    
    while num > 0:
        digit = num % 10
        total += digit**power
        num = num // 10
    
    return total
    

print(digitNthPowersSum(4))
print(digitNthPowersSum(5))
