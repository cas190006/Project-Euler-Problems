"""
The decimal number, 585 = 1001001001₂ (binary), is palindromic in both bases.

Find the sum of all numbers, less than one million, which are palindromic in base 10 and base 2.

(Please note that the palindromic number, in either base, may not include leading zeros.)

ANSWER: 872187
"""

# Time: O(n log n), Space: O(log n)
def doubleBasePalindromeSum(n):
    total = 0
    
    for i in range(1, n, 2):
        if isPalindrome(i):
            base2Num = bin(i)[2:]
            if base2Num == base2Num[::-1]:
                total += i
    
    return total

# Time O(d), Space O(1)
# d = digits of n
def isPalindrome(n):
    if n < 0 or (n % 10 == 0 and n != 0):
        return False
    
    original = n
    reversed_n = 0
    
    while n > 0:
        digit = n % 10
        reversed_n = (reversed_n * 10) + digit
        n = n // 10
        
    return original == reversed_n

# Time: O(n^(1/2) log n), Space: O(n^(1/2))
def doubleBasePalindromeSumKnownalindromes(n):
    total = 0
    palindromes = palindromesLessThanN(n)
    
    for palindrome in palindromes:
        base2Num = bin(palindrome)[2:]
        if base2Num == base2Num[::-1]:
            total += palindrome
    
    return total

# Time: O(n^(1/2) log n), Space: O(n^(1/2))
def palindromesLessThanN(n):
    palindromes = set()
    limit = 10 ** ((len(str(n)) + 1) // 2)

    for num in range(1, limit):
        numStr = str(num)

        oddPalindrome = int(numStr + numStr[-2::-1])
        if oddPalindrome < n:
            palindromes.add(oddPalindrome)

        evenPalindrome = int(numStr + numStr[::-1])
        if evenPalindrome < n:
            palindromes.add(evenPalindrome)
        
    return palindromes


print(doubleBasePalindromeSum(1000000))
print(doubleBasePalindromeSumKnownalindromes(1000000))
