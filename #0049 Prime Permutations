"""
The arithmetic sequence, 1487, 4817, 8147, in which each of the three terms increases by 3330, is unusual in two ways:

(i) each of the three terms are prime, and,
(ii) each of the 4-digit numbers are permutations of one another.
    
There are no arithmetic sequences made up of three 1-, 2-, or 3-digit primes, exhibiting this property, but there is one other 4-digit increasing sequence.

What 12-digit number do you form by concatenating the three terms in this sequence?

ANSWER: 296962999629
"""

# Time: O(1), Space: O(1)
def primePermutations():
    primes = primesLessThanN(9999)
    limit = 9999 - 6660
    
    primePermutationConcatenates = []
    
    for term1 in range(1111, limit+1):
        term2 = term1 + 3330
        term3 = term2 + 3330
        
        if sorted(str(term1)) == sorted(str(term2)) == sorted(str(term3)) and term1 in primes and term2 in primes and term3 in primes:
            primePermutationConcatenates.append(str(term1) + str(term2) + str(term3))
    
    return primePermutationConcatenates
    
# Time: O(n log log n), Space: O(n)
def primesLessThanN(n):
    primes = set()
    nums = [True] * (n+1)
    
    for p in range(2, n+1):
        if nums[p]:
            primes.add(p)
            for i in range(p*p, n+1, p):
                nums[i] = False

    return primes
    

print(primePermutations())
