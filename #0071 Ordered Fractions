import math
"""
Consider the fraction, n/d, where n and d are positive integers.
If n < d and HCF(n, d) = 1, it is called a reduced proper fraction.

If we list the set of reduced proper fractions for d <= 8 in ascending order of size, we get:
1/8, 1/7, 1/6, 1/5, 1/4, 2/7, 1/3, 3/8, 2/5, 3/7, 1/2, 4/7, 3/5, 5/8, 2/3, 5/7, 3/4, 4/5, 5/6, 6/7, 7/8

It can be seen that 2/5 is the fraction immediately to the left of 3/7.

By listing the set of reduced proper fractions for d <= 1,000,000 in ascending order of size, find the numerator of the fraction immediately to the left of 3/7.

ANSWER: 428570
"""

# Time: O(n^2), Space: O(1)
def orderedFractionsBrute(n, targetFraction):
    targetNum, targetDenom = targetFraction
    
    if targetDenom > n or targetNum < 1 or n <= targetNum or targetNum >= targetDenom:
        return None
    
    bestNum = 0
    bestDenom = 1

    for denom in range(2, n + 1):
        for num in range(1, denom):
            if math.gcd(num, denom) == 1:
                if num * targetDenom < targetNum * denom:
                    if num * bestDenom > bestNum * denom:
                        bestNum = num
                        bestDenom = denom

    return bestNum, bestDenom

# Time: O(n), Space: O(1)
def orderedFractions(n, targetFraction):
    targetNum, targetDenom = targetFraction
    
    if targetDenom > n or targetNum < 1 or n <= targetNum or targetNum > targetDenom:
        return None
    
    bestNum = 0
    bestDenom = 1
    
    for denom in range(2, n+1):
        num = ((targetNum * denom) - 1) // targetDenom
        
        if num * bestDenom > bestNum * denom:
            bestNum = num
            bestDenom = denom

    return bestNum, bestDenom


print(orderedFractionsBrute(8, (3, 7)))
print(orderedFractions(8, (3, 7)))

print(orderedFractions(1000000, (3, 7)))
