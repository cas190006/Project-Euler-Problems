"""
If the numbers 1 to 5 are written out in words: one, two, three, four, five, then there are 3 + 3 + 5 + 4 + 4 = 19 letters used in total.

If all the numbers from 1 to 1000 (one thousand) inclusive were written out in words, how many letters would be used?

NOTE: Do not count spaces or hyphens. For example, 342 (three hundred and forty-two) contains 23 letters and 115 (one hundred and fifteen) contains 20 letters.
The use of "and" when writing out numbers is in compliance with British usage.

ANSWER: 21124
"""

# Time O(n log n), Space O(n)
def numberLetterCountsBrute(n):
    count = 0
    
    for i in range(1, n+1):
        numWord = numberToWord(i).replace(" ", "")
        count += len(numWord)
    
    return count

# Time O(d), Space O(1)
# d = number of decimal digits in num
def numberToWord(num):
    if num == 0:
        return "zero"
    
    digits = ["", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine"]
    teens = ["ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"]
    tens = ["", "", "twenty", "thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety"]
    word = ""
    
    while 0 < num:
        if num < 10:
            word += digits[num]
            num = 0
        elif num < 20:
            word += teens[num-10]
            num = 0
        elif num < 100:
            word += tens[num // 10] + " "
            num -= (num // 10)*10
        elif num < 1000:
            word += digits[num // 100] + " hundred "
            if num % 100 != 0:
                word += "and "
            num -= (num // 100)*100
        elif num < 10000:
            word += digits[num // 1000] + " thousand "
            if num % 1000 != 0:
                word += "and "
            num -= (num // 1000)*1000
            
    return word

# Time O(n log n), Space O(1)
def numberLetterCountsCounter(n):
    count = 0
    
    digits = [0, 3, 3, 5, 4, 4, 3, 5, 5, 4]
    teens = [3, 6, 6, 8, 8, 7, 7, 9, 8, 8]
    tens = [0, 0, 6, 6, 5, 5, 5, 7, 6, 6]
    
    for i in range(1, n+1):
        num = i
        length = 0
        
        while 0 < num:
            if num < 10:
                length += digits[num]
                num = 0
            elif num < 20:
                length += teens[num-10]
                num = 0
            elif num < 100:
                length += tens[num // 10]
                num -= (num // 10)*10
            elif num < 1000:
                length += digits[num // 100] + 7
                if num % 100 != 0:
                    length += 3
                num -= (num // 100)*100
            elif num < 10000:
                length += digits[num // 1000] + 8
                if num % 1000 != 0:
                    length += 3
                num -= (num // 1000)*1000
                
        count += length
    
    return count
    
    
print(numberLetterCountsBrute(5))
print(numberLetterCountsCounter(5))

print(numberLetterCountsBrute(1000))
print(numberLetterCountsCounter(1000))
