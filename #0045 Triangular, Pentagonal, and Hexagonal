import math
"""
Triangle, pentagonal, and hexagonal numbers are generated by the following formula:
Triangle: Tn = n(n + 1)/2 — 1, 3, 6, 10, 15, …
Pentagonal: Pn = n(3n − 1)/2 — 1, 5, 12, 22, 35, …
Hexagonal: Hn = n(2n − 1) — 1, 6, 15, 28, 45, …

It can be verified that T₂₈₅ = P₁₆₅ = H₁₄₃ = 40755.
Find the next triangle number that is also pentagonal and hexagonal.

ANSWER: 1533776805
"""

# Time: O(T),  Space: O(n)
# Given T is triangular index where the nth match is found
def nthTriPentaHexaNumber(n):
    if n < 1:
        return None
    
    numbers = []
    t = 1
    
    while len(numbers) < n:
        triangular = (t*(t+1)) // 2
        
        if (1 + math.sqrt(1 + 24*triangular)) % 6 == 0 and (1 + math.sqrt(1 + 8*triangular)) % 4 == 0:
            numbers.append(triangular)
            
        t += 1
    
    return numbers[n-1]
    
    
print(nthTriPentaHexaNumber(3))
