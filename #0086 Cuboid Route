import math
"""
A spider, S, sits in one corner of a cuboid room, measuring 6 by 5 by 3, and a fly, F, sits in the opposite corner.
By travelling on the surfaces of the room the shortest "straight line" distance from S to F is 10 and the path is shown on the diagram.

However, there are up to three "shortest" path candidates for any given cuboid and the shortest route doesn't always have integer length.

It can be shown that there are exactly 2060 distinct cuboids, ignoring rotations, with integer dimensions, up to a maximum size of M by M by M, for which the shortest route has integer length when M = 100.
This is the least value of M for which the number of solutions first exceeds two thousand; the number of solutions when M = 99 is 1975.

Find the least value of M such that the number of solutions first exceeds one million.

ANSWER: 1818
"""

# Time: O(m^3),  Space: O(1)
def cuboidRoutesBrute(solutions):
    m = 2
    cuboids = 0
    
    while cuboids < solutions:
        m += 1
        
        for b in range(1, m+1):
            for a in range(1, b+1):
                if math.sqrt(m**2 + (a+b)**2) == math.isqrt(m**2 + (a+b)**2):
                    cuboids += 1
    
    return m

# Time: O(m^2),  Space: O(1)
def cuboidRoutesThreshold(solutions):
    m = 2
    cuboids = 0

    while cuboids < solutions:
        m += 1

        for s in range(2, 2 * m + 1):
            if math.isqrt(m * m + s * s) ** 2 == m * m + s * s:
                aMin = max(1, s - m)
                aMax = s // 2
                cuboids += max(0, aMax - aMin + 1)

    return m


print(cuboidRoutesBrute(2000))
print(cuboidRoutesThreshold(2000))

print(cuboidRoutesBrute(1000000))
print(cuboidRoutesThreshold(1000000))
