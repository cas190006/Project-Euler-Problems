import math
"""
Triangle, square, pentagonal, hexagonal, heptagonal, and octagonal numbers are all figurate (polygonal) numbers and are generated by the following formulae:

Triangle: P₃,n = n(n+1)/2 → 1, 3, 6, 10, 15, …
Square: P₄,n = n² → 1, 4, 9, 16, 25, …
Pentagonal: P₅,n = n(3n−1)/2 → 1, 5, 12, 22, 35, …
Hexagonal: P₆,n = n(2n−1) → 1, 6, 15, 28, 45, …
Heptagonal: P₇,n = n(5n−3)/2 → 1, 7, 18, 34, 55, …
Octagonal: P₈,n = n(3n−2) → 1, 8, 21, 40, 65, …

The ordered set of three 4-digit numbers: 8128, 2882, 8281, has three interesting properties.

1. The set is cyclic, in that the last two digits of each number is the first two digits of the next number (including the last number with the first).
2. Each polygonal type: triangle (P₃,127 = 8128), square (P₄,91 = 8281), and pentagonal (P₅,44 = 2882), is represented by a different number in the set.
3. This is the only set of 4-digit numbers with this property.

Find the sum of the only ordered set of six cyclic 4-digit numbers for which each polygonal type: triangle, square, pentagonal, hexagonal, heptagonal, and octagonal, is represented by a different number in the set.

ANSWER: 28684
"""

# Time: O(n * n!),  Space: O(n * n!)
def cyclicalFigurateNumbersSumStack(n, digit):
    prefixLength = digit // 2
    indexDigitLength = prefixLength
    if digit % 2 != 0:
        indexDigitLength += 1
        
    prefixBase = 10 ** prefixLength
    minimumSuffix = 10 ** (prefixLength - 1)
    indexBase = 10 ** indexDigitLength
        
    polygonalTypes = list(range(n+1, 2, -1))
    
    startIndex = polygonalIndexFormula(n+2, 10 ** (digit - 1))
    endIndex = polygonalIndexFormula(n+2, 10 ** digit)
    
    for index in range(startIndex, endIndex):
        startNumber = polygonalNumberFormula(n+2, index)
        numbers = [startNumber]
        
        if startNumber % prefixBase >= minimumSuffix:
            searchStack = [([], polygonalTypes, numbers)]
            
            while searchStack:
                selectedTypes, remainingTypes, cyclicNumbers = searchStack.pop()
                
                if not remainingTypes and len(cyclicNumbers) == n and cyclicNumbers[0] // prefixBase == cyclicNumbers[-1] % prefixBase:
                    #print(cyclicNumbers)
                    return sum(cyclicNumbers)
                
                for polygonalType in remainingTypes:
                    currentSuffix = cyclicNumbers[-1] % prefixBase
                    
                    candidateStart = polygonalIndexFormula(polygonalType, currentSuffix * indexBase)
                    candidateEnd = polygonalIndexFormula(polygonalType, (currentSuffix + 1) * indexBase)
                    
                    for index in range(candidateStart, candidateEnd):
                        candidate = polygonalNumberFormula(polygonalType, index)
                        
                        candidatePrefix = candidate // prefixBase
                        candidateSuffix = candidate % prefixBase
                        
                        if candidatePrefix == currentSuffix and candidateSuffix >= minimumSuffix and candidate not in cyclicNumbers:
                            remaining = remainingTypes.copy()
                            remaining.remove(polygonalType)

                            searchStack.append((selectedTypes + [polygonalType], remaining, cyclicNumbers + [candidate]))
                    
    return None

# Time: O(1),  Space: O(1)
def polygonalNumberFormula(s, n):
    return ((s-2)*(n ** 2) - (s-4)*n) // 2

# Time: O(1),  Space: O(1)
def polygonalIndexFormula(s, num):
    return math.ceil(((s-4) + math.sqrt((s-4)**2 + 8*num*(s-2))) / (2*(s-2)))

# Time: O(n^2 * M^2),  Space: O(n^2 * M^2)
# Given M = number of generated polygonal numbers per type
def cyclicalFigurateNumbersSumGraph(n, digit):
    prefixLength = digit // 2
    
    prefixBase = 10 ** prefixLength
    minimumSuffix = 10 ** (prefixLength - 1)
    
    cyclicGraph = {}
    
    for polygonalType in range(n+2, 2, -1):
        startIndex = polygonalIndexFormula(polygonalType, 10 ** (digit-1))
        endIndex = polygonalIndexFormula(polygonalType, 10 ** digit)
        
        for index in range(startIndex, endIndex):
            candidate = polygonalNumberFormula(polygonalType, index)
            
            candidatePrefix = candidate // prefixBase
            candidateSuffix = candidate % prefixBase
            
            graphNodes = list(cyclicGraph)
            
            if (polygonalType, candidate) not in cyclicGraph and candidate % prefixBase >= minimumSuffix:
                cyclicGraph[(polygonalType, candidate)] = []
                
            for otherType, otherNumber in graphNodes:
                otherPrefix = otherNumber // prefixBase
                otherSuffix = otherNumber % prefixBase
                
                if polygonalType != otherType:
                    if otherSuffix == candidatePrefix and candidate not in cyclicGraph[(otherType, otherNumber)]:
                        cyclicGraph[(otherType, otherNumber)].append((polygonalType, candidate))
                    
                    if candidateSuffix == otherPrefix and otherNumber not in cyclicGraph[(polygonalType, candidate)]:
                        cyclicGraph[(polygonalType, candidate)].append((otherType, otherNumber))
                        
    graph = {k: v for k, v in cyclicGraph.items() if v != []}
    firstCycle = firstNDirectedCycle(graph, n)
    #print(firstCycle)
    
    if firstCycle is not None:
        return sum(x[1] for x in firstCycle)
    
    return None

# Time: O(n * n!),  Space: O(n^2)
def firstNDirectedCycle(graph, n):
    def search(start, current, cycle, usedTypes):
        if len(cycle) == n:
            if start in graph.get(current, []):
                return cycle
            return None

        for neighbor in graph.get(current, []):
            polygonalType = neighbor[0]

            if polygonalType in usedTypes:
                continue

            foundCycle = search(start, neighbor, cycle + [neighbor], usedTypes | {polygonalType})

            if foundCycle is not None:
                return foundCycle

        return None

    for start in graph:
        if start[0] == n+2:
            cycle = search(start, start, [start], {start[0]})

            if cycle is not None:
                return cycle

    return None


print(cyclicalFigurateNumbersSumStack(3, 4))
print(cyclicalFigurateNumbersSumGraph(3, 4))

print(cyclicalFigurateNumbersSumStack(6, 4))
print(cyclicalFigurateNumbersSumGraph(6, 4))
