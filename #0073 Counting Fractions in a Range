import math
"""
Consider the fraction n/d, where n and d are positive integers. If n < d and HCF(n, d) = 1, it is called a reduced proper fraction.

If we list the set of reduced proper fractions for d ≤ 8 in ascending order of size, we get:
1/8, 1/7, 1/6, 1/5, 1/4, 2/7, 1/3, 3/8, 2/5, 3/7, 1/2, 4/7, 3/5, 5/8, 2/3, 5/7, 3/4, 4/5, 5/6, 6/7, 7/8

It can be seen that there are 3 fractions between 1/3 and 1/2.

How many fractions lie between 1/3 and 1/2 in the sorted set of reduced proper fractions for d ≤ 12,000?

ANSWER: 7295372
"""

# Time: O(n^2), Space: O(1)
def countingFractionsRange(d, leftFraction, rightFraction):
    leftNum, leftDenom = leftFraction
    rightNum, rightDenom = rightFraction
    
    if not (0 < leftNum < leftDenom and 0 < rightNum < rightDenom):
        return None
    
    if leftNum * rightDenom == rightNum * leftDenom:
        return 0
    
    if (leftNum / leftDenom) > (rightNum / rightDenom):
        leftNum, leftDenom, rightNum, rightDenom = (rightNum, rightDenom, leftNum, leftDenom)
    
    count = 0
    
    for denom in range(2, d+1):
        low = (denom * leftNum) // leftDenom
        high = (denom * rightNum - 1) // rightDenom
        
        for num in range(low+1, high+1):
            if math.gcd(num, denom) == 1:
                count += 1
        
    return count


print(countingFractionsRange(8, (1, 2), (1, 3)))
print(countingFractionsRange(12000, (1, 3), (1, 2)))
