import itertools
"""
Each of the six faces on a cube has a different digit (0 to 9) written on it; the same is done to a second cube.
By placing the two cubes side-by-side in different positions we can form a variety of 2-digit numbers.

For example, the square number 64 could be formed.

In fact, by carefully choosing the digits on both cubes it is possible to display all of the square numbers below one-hundred: 01, 04, 09, 16, 25, 36, 49, 64, and 81.

For example, one way this can be achieved is by placing 9 on one cube and 9 on the other cube.

However, for this problem we shall allow the 6 or 9 to be turned upside-down so that an arrangement like 9 and 7 allows for all nine square numbers to be displayed;
otherwise it would be impossible to obtain 09.

In determining a distinct arrangement we are interested in the digits on each cube, not the order.
- 6 is equivalent to 5.
- 6 is distinct from 9.

But because we are allowing 6 and 9 to be reversed, the two distinct sets in the last example both represent the extended set 9 for the purpose of forming 2-digit numbers.

How many distinct arrangements of the two cubes allow for all of the square numbers to be displayed?

ANSWER: 1217
"""

# Time: O(1), Space: O(1)
def cubeDigitPairs():
    digits = {i for i in range(10)}
    squares = [f"{num:02d}" for num in [i**2 for i in range(1, 10)]]
    
    cubeSides = [set(comb) for comb in itertools.combinations(digits, 6)]
    pairs = list(itertools.combinations(cubeSides, 2))
    
    arrangements = 0
            
    for c1, c2 in pairs:
        valid = True
        for square in squares:
            first, last = int(square[0]), int(square[1])
            
            first_options = {first}
            last_options = {last}

            if first in (6, 9):
                first_options = {6, 9}
            if last in (6, 9):
                last_options = {6, 9}
                
            if not ((any(d in c1 for d in first_options) and any(d in c2 for d in last_options))
                    or (any(d in c2 for d in first_options) and any(d in c1 for d in last_options))):
                valid = False
                break
    
        if valid:
            arrangements += 1
    
    return arrangements


print(cubeDigitPairs())
