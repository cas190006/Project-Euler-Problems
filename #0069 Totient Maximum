import math
"""
Euler's totient function, φ(n) [sometimes called the phi function], is defined as the number of positive integers not exceeding n which are relatively prime to n.
For example, as 1, 2, 4, 5, 7, and 8, are all less than or equal to nine and relatively prime to nine, φ(9) = 6.

n | Relatively Prime | φ(n) | n/φ(n)

2 | 1 | 1 | 2
3 | 1,2 | 2 | 1.5
4 | 1,3 | 2 | 2
5 | 1,2,3,4 | 4 | 1.25
6 | 1,5 | 2 | 3
7 | 1,2,3,4,5,6 | 6 | 1.1666...
8 | 1,3,5,7 | 4 | 2
9 | 1,2,4,5,7,8 | 6 | 1.5
10 | 1,3,7,9 | 4 | 2.5

It can be seen that n = 6 produces a maximum n/φ(n) for n ≤ 10.

Find the value of n ≤ 1,000,000 for which n/φ(n) is a maximum.

ANSWER: 510510
"""

# Time: O(n * sqrt(n)), Space: O(1)
def totientMaximumBrute(n):
    maxN = 1
    maxValue = 0

    for i in range(2, n+1):
        totientValue = totient(i)
        fraction = i / totientValue

        if fraction > maxValue:
            maxValue = fraction
            maxN = i

    return maxN

# Time O(sqrt(n)), Space O(1)
def totient(n):
    if n < 2:
        if n == 1:
            return 1
        else:
            return None

    result = n

    for i in range(2, int(math.sqrt(n)) + 1):
        if n % i == 0:
            while n % i == 0:
                n //= i
            result -= result // i

    if n > 1:
        result -= result // n

    return result

# Time: O(n log log n), Space: O(n)
def totientMaximumBruteSieve(n):
    maxN = 1
    maxValue = 0
    totients = totientsLessThanOrEqualN(n)

    for i in range(2, n+1):
        fraction = i / totients[i]

        if fraction > maxValue:
            maxValue = fraction
            maxN = i

    return maxN

# Time: O(n log log n), Space: O(n)
def totientsLessThanOrEqualN(n):
    totients = list(range(n+1))

    for p in range(2, n+1):
        if totients[p] == p:
            for j in range(p, n+1, p):
                totients[j] -= totients[j] // p

    return totients

# Time: O((n * sqrt(n)) / log(n)), Space: O(1)
def totientMaximum(n):
    num = 2
    maxN = 1
    
    while maxN * num <= n:
        if isPrime(num):
            maxN *= num
            
        num += 1
        
    return maxN

# Time O(sqrt(n)), Space O(1)
def isPrime(n):
    if n <= 1:
        return False

    for i in range(2, int(math.sqrt(n)) + 1):
        if n % i == 0:
            return False

    return True


print(totientMaximumBrute(10))
print(totientMaximumBruteSieve(10))
print(totientMaximum(10))

print(totientMaximumBrute(1000000))
print(totientMaximumBruteSieve(1000000))
print(totientMaximum(1000000))
