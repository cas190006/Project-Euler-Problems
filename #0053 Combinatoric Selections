import math
"""
There are exactly ten ways of selecting three from five, 12345:
123, 124, 125, 134, 135, 145, 234, 235, 245, and 345

In combinatorics, we use the notation, (5 choose 3) = 10.

In general, (n choose r) = n! / (r!(n-r)!), where r <= n, n! = n × (n-1) × ... × 3 × 2 × 1, and 0! = 1.

It is not until n = 23, that a value exceeds one-million: (23 choose 10) = 1144066.

How many, not necessarily distinct, values of (n choose r) for 1 <= n <= 100, are greater than one-million?

ANSWER: 4075
"""

# Time: O(n^2), Space: O(1)
def combinatoricSelectionsBrute(maxN, minimumValue):
    total = 0
    
    for n in range(1, maxN+1):
        for r in range(1, n+1):
            if math.comb(n, r) > minimumValue:
                total += 1
    return total

# Time: O(n^2), Space: O(1)
def combinatoricSelections(maxN, minimumValue):
    if minimumValue <= 0:
        return (maxN*(maxN+1))// 2
    
    total = 0
    
    for n in range(1, maxN+1):
        for r in range(1, n//2 + 1):
            if math.comb(n, r) > minimumValue:
                total += n-(2*r)+1
                break
    return total


print(combinatoricSelectionsBrute(100, 1000000))
print(combinatoricSelections(100, 1000000))
