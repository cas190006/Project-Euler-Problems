"""
You are given the following information, but you may prefer to do some research for yourself.

* 1 Jan 1900 was a Monday.
* Thirty days has September,
April, June and November.
All the rest have thirty-one,
Saving February alone,
Which has twenty-eight, rain or shine.
And on leap years, twenty-nine.
* A leap year occurs on any year evenly divisible by 4, but not on a century unless it is divisible by 400.

How many Sundays fell on the first of the month during the twentieth century (1 Jan 1901 to 31 Dec 2000)?

ANSWER: 171
"""

# Time O(n), Space O(1)
# n = number of years from 1901 through endYear
def countingDays(dayName, endYear):
    dayName = dayName.lower()
    monthDays = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    firstDay = 0
    
    month = 1
    year = 1901
    
    if dayName == "tuesday":
        day = 1
        firstDay += 1
    elif dayName == "wednesday":
        day = 2
    elif dayName == "thursday":
        day = 3
    elif dayName == "friday":
        day = 4
    elif dayName == "saturday":
        day = 5
    elif dayName == "sunday":
        day = 6
    elif dayName == "monday":
        day = 7
    
    while year <= endYear:
        day += 7
        
        if monthDays[month-1] < day:
            if month == 2 and isLeapYear(year):
                day -= monthDays[month-1]+1
            else:
                day -= monthDays[month-1]
            month += 1
            
        if 12 < month:
            month = 1
            year += 1
            
        if day == 1:
            firstDay += 1
        
    return firstDay

# Time O(1), Space O(1)
def isLeapYear(year):
    if year % 4 == 0:
        if year % 100 == 0:
            if year % 400 == 0:
                return True
            else:
                return False
        else:
            return True
    else:
        return False
    
# Time O(n), Space O(1)
# n = number of years from 1900 through endYear
def countingDaysStart1900(dayName, startYear, endYear):
    dayName = dayName.lower()
    monthDays = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    firstDay = 0
    
    month = 1
    year = 1900
    
    if dayName == "monday":
        day = 1
    elif dayName == "tuesday":
        day = 2
    elif dayName == "wednesday":
        day = 3
    elif dayName == "thursday":
        day = 4
    elif dayName == "friday":
        day = 5
    elif dayName == "saturday":
        day = 6
    elif dayName == "sunday":
        day = 7
    
    while year <= endYear:
        day += 7
        
        if monthDays[month-1] < day:
            if month == 2 and isLeapYear(year):
                day -= monthDays[month-1]+1
            else:
                day -= monthDays[month-1]
            month += 1
            
        if 12 < month:
            month = 1
            year += 1
            
        if day == 1 and startYear <= year:
            firstDay += 1
        
    return firstDay


print(countingDays("Sunday", 2000))
print(countingDaysStart1900("Sunday", 1901, 2000))
