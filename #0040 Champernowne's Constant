import math
"""
An irrational decimal fraction is created by concatenating the positive integers:
0.123456789101112131415161718192021…
It can be seen that the 12th digit of the fractional part is 1.

If dn represents the nth digit of the fractional part, find the value of the following expression.
d₁ × d₁₀ × d₁₀₀ × d₁₀₀₀ × d₁₀₀₀₀ × d₁₀₀₀₀₀ × d₁₀₀₀₀₀₀

ANSWER: 210
"""

# Time: O(N^2), Space: O(N)
# Given N is the largest in nths
def champernowneConstantMultiple(nths):
    product = 1
    
    for n in nths:
        product *= dn(n)
    
    return product

# Time: O(n^2), Space: O(n)
def dn(n):
    fractional = "1"
    num = 2
    
    while len(fractional) < n:
        fractional += str(num)
        num += 1
        
    return int(fractional[n-1])

# Time: O(N), Space: O(N)
# Given N is the largest in nths
def champernowneConstantMultipleLinear(nths):
    product = 1
    
    nums = []
    maxN = max(nths)
    num = 1
    fractionalLength = 0
    
    while fractionalLength < maxN:
        nums.append(str(num))
        num += 1
        fractionalLength += math.log10(num)

    fractional = ''.join(nums)
        
    for n in nths:
        product *= int(fractional[n-1])
    
    return product


nths = [1, 10, 100, 1000, 10000, 100000, 1000000]

print(champernowneConstantMultiple(nths))
print(champernowneConstantMultipleLinear(nths))
