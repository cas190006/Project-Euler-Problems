"""
Starting with the number 1 and moving to the right in a clockwise direction, a 5 by 5 spiral is formed as follows:

21 22 23 24 25
20  7  8  9 10
19  6  1  2 11
18  5  4  3 12
17 16 15 14 13

The numbers on the diagonals are 21, 25, 7, 9, 1, 5, 3, 17, 13.
It can be verified that the sum of these numbers is 101.

What is the sum of the numbers on the diagonals in a 1001 by 1001 spiral formed in the same way?

ANSWER: 669171001
"""

# Time: O(n^2),  Space: O(n^2)
def numberSpiralDiagonalsBrute(n):
    if n % 2 == 0:
        return None
    
    spiral = createSpiral(n)
    total = 1
    
    for i in range(n):
        if i != n//2:
            total += spiral[i][0+i]
            total += spiral[i][n-1-i]
            
    return total
    
# Time: O(n^2),  Space: O(n^2)
def createSpiral(n):
    spiral = [[1 for _ in range(n)] for _ in range(n)]
    num = 1
    
    row = n//2
    col = (n//2)
    
    for i in range(n//2):
        # right
        num += 1
        col += 1
        spiral[row][col] = num
        
        # down
        for _ in range((2*i)+1):
            num += 1
            row += 1
            spiral[row][col] = num
        
        # left
        for _ in range((2*i)+2):
            num += 1
            col -= 1
            spiral[row][col] = num
        
        # up
        for _ in range((2*i)+2):
            num += 1
            row -= 1
            spiral[row][col] = num
        
        # right
        for _ in range((2*i)+2):
            num += 1
            col += 1
            spiral[row][col] = num
            
    return spiral

# Time: O(n^2),  Space: O(1)
def numberSpiralDiagonalsWalk(n):
    if n % 2 == 0:
        return None
    
    total = 1
    num = 1
    
    for i in range(n//2):
        # right
        num += 1
        
        # down
        for _ in range((2*i)+1):
            num += 1
        total += num
        
        # left
        for _ in range((2*i)+2):
            num += 1
        total += num
        
        # up
        for _ in range((2*i)+2):
            num += 1
        total += num
        
        # right
        for _ in range((2*i)+2):
            num += 1
        total += num
        
    return total

# Time: O(n),  Space: O(1)
def numberSpiralDiagonalsCorners(n):
    if n % 2 == 0:
        return None
    
    total = 1
    num = 1
    
    for step in range(2, n, 2):
        for _ in range(4):
            num += step
            total += num
    
    return total


print(numberSpiralDiagonalsBrute(5))
print(numberSpiralDiagonalsWalk(5))
print(numberSpiralDiagonalsCorners(5))

print(numberSpiralDiagonalsBrute(1001))
print(numberSpiralDiagonalsWalk(1001))
print(numberSpiralDiagonalsCorners(1001))
