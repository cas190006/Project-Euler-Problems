import math
"""
The sum of the primes below 10 is 2 + 3 + 5 + 7 = 17.
Find the sum of all the primes below two million.

ANSWER: 142913828922
"""

# Time O(n^(3/2)), Space O(1)
def summationOfPrimesBrute(n):
    if n <= 2:
        return 0
    
    total = 2
    jump = 2
    for i in range(3, n, jump):
        if isPrime(i):
            total += i
            
        if jump == 2:
            jump = 4
        else:
            jump = 2
            
    return total

# Time O(sqrt(n)), Space O(1)
def isPrime(n):
    if n <= 1:
        return False

    for i in range(2, int(math.sqrt(n)) + 1):
        if n % i == 0:
            return False

    return True

# Time O(n log log n), Space O(n)
def summationOfPrimesSieve(n):
    if n <= 2:
        return 0
    
    nums = [True] * (n)
    total = 2
    
    for p in range(3, n, 2):
        if nums[p]:
            total += p
            for i in range(p*p, n, p):
                nums[i] = False

    return total
    

print(summationOfPrimesBrute(10))
print(summationOfPrimesSieve(10))

print(summationOfPrimesBrute(2000000))
print(summationOfPrimesSieve(2000000))
