"""
The minimal path sum in the 5 by 5 matrix below, by starting in any cell in the left column and finishing in any cell in the right column, and only moving up, down, and right, is indicated in red and bold; the sum is equal to 944.

 131   673  234   *103*  *18*
*201* *96* *342*  *965*  150
 630   803  746    422   111
 537   699  497    121   956
 805   732  524    37   331 

Find the minimal path sum from the left column to the right column in matrix.txt

ANSWER: 260324
"""

# Time: O(rows * cols), Space: O(rows * cols)
def minPathSum(matrix):
    rows = len(matrix)
    cols = len(matrix[0])
    minPathMatrix = [row[:] for row in matrix]
    
    for c in range(1, cols):
        for r in range(0, rows):
            if r == 0:
                minPathMatrix[r][c] = minPathMatrix[r][c] + minPathMatrix[r][c-1]
            else:
                minPathMatrix[r][c] = minPathMatrix[r][c] + min(minPathMatrix[r][c-1], minPathMatrix[r-1][c])
                
        for r in range(rows-2, -1, -1):
            minPathMatrix[r][c] = min(minPathMatrix[r][c], matrix[r][c] + minPathMatrix[r+1][c])
    
    return min(row[cols-1] for row in minPathMatrix)

# Time: O(rows * cols), Space: O(rows)
def minPathSumRow(matrix):
    rows = len(matrix)
    cols = len(matrix[0])
    
    minPathCol = [matrix[r][0] for r in range(rows)]

    for c in range(1, cols):
        for r in range(rows):
            if r == 0:
                minPathCol[r] += matrix[r][c]
            else:
                minPathCol[r] = matrix[r][c] + min(minPathCol[r], minPathCol[r - 1])
                
        for r in range(rows - 2, -1, -1):
            minPathCol[r] = min(minPathCol[r], matrix[r][c] + minPathCol[r + 1])

    return min(minPathCol)


with open('matrix.txt', 'r') as file:
    matrix = [list(map(int, row.split(","))) for row in file.read().split('\n')[:-1]]

testMatrix = [
    [131, 673, 234, 103, 18],
    [201,  96, 342, 965, 150],
    [630, 803, 746, 422, 111],
    [537, 699, 497, 121, 956],
    [805, 732, 524,  37, 331]
]

print(minPathSum(testMatrix))
print(minPathSumRow(testMatrix))

print(minPathSum(matrix))
print(minPathSumRow(matrix))
