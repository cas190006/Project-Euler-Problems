import math
"""
Pentagonal numbers are generated by the formula, Pn = n(3n − 1)/2. The first ten pentagonal numbers are:
1, 5, 12, 22, 35, 51, 70, 92, 117, 145, …

It can be seen that P₄ + P₇ = 22 + 70 = 92 = P₈. However, their difference, 70 − 22 = 48, is not pentagonal.

Find the pair of pentagonal numbers, Pj and Pk, for which their sum and difference are pentagonal and D = |Pk − Pj| is minimised; what is the value of D?

ANSWER: 5482660
"""

# Time: O(1),  Space: O(1)
def minimisedPentagonNumbersBrute():
    k = 2
    
    while True:
        for j in range(k-1, 0, -1):
            pSum = ((k*(3*k - 1)) // 2) + ((j*(3*j - 1)) // 2)
            pDiff = ((k*(3*k - 1)) // 2) - ((j*(3*j - 1)) // 2)
            
            if (1 + math.sqrt(1 + 24*pSum)) % 6 == 0 and (1 + math.sqrt(1 + 24*pDiff)) % 6 == 0:
                return pDiff
        k += 1

# Time: O(1),  Space: O(1)
def minimisedPentagonNumbers():
    d = 2
    
    while True:
        pDiffTwice = d*(3*d - 1)
        sqrtNum = int(math.sqrt(pDiffTwice))
        
        for a in range(2, sqrtNum+1):
            if pDiffTwice % a != 0:
                continue
            
            b = pDiffTwice // a

            if b < 3*a:
                break

            if b % 3 == 2:
                c = (b + 1) // 3

                if a % 2 == c % 2:
                    k = (a + c) // 2
                    j = (c - a) // 2

                    pSum = ((k*(3*k - 1)) // 2) + ((j*(3*j - 1)) // 2)
                    
                    if (1 + math.sqrt(1 + 24*pSum)) % 6 == 0:
                        return pDiffTwice // 2
                    
        d += 1


print(minimisedPentagonNumbersBrute())
print(minimisedPentagonNumbers())
