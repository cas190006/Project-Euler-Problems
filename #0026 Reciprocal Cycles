"""
A unit fraction contains 1 in the numerator. The decimal representations of the unit fractions with denominators 2 to 10 are:

1/2 = 0.5
1/3 = 0.(3)
1/4 = 0.25
1/5 = 0.2
1/6 = 0.1(6)
1/7 = 0.(142857)
1/8 = 0.125
1/9 = 0.(1)
1/10 = 0.1

Here, 0.1(6) means 0.166666..., and has a 1-digit recurring cycle. It can be seen that 1/7 has a 6-digit recurring cycle.

Find the value of d < 1000 for which 1/d contains the longest recurring cycle in its decimal fraction part.

ANSWER: 983
"""

# Time: O(n^2), Space: O(n)
# Given n = limit
def longestRecurringCycleNum(limit):
    longest = 0
    num = 1
    
    for i in range(2, 1000):
        length = recurringCycleLength(i)
        
        if longest < length:
            longest = length
            num = i
    
    return num
    
# Time: O(n), Space: O(n)
# Given n = denominator
def recurringCycleLength(denominator):
    remainders = {}
    remainder = 1 % denominator
    position = 0

    while remainder != 0:
        if remainder in remainders:
            return position - remainders[remainder]

        remainders[remainder] = position
        remainder = (remainder * 10) % denominator
        position += 1

    return 0


for i in range(2, 11):
    print(recurringCycleLength(i))
    
print(longestRecurringCycleNum(1000))
