import math
from itertools import combinations
"""
The primes 3, 7, 109, and 673 are quite remarkable. By taking any two primes and concatenating them in any order, the result will always be prime.
For example, taking 7 and 109, both 7109 and 1097 are prime. The sum of these four primes, 792, represents the lowest sum for a set of four primes with this property.

Find the lowest sum for a set of five primes for which any two primes concatenate to produce another prime.

ANSWER: 26033
"""

# Time: O(10^(3n) / n^2),  Space: O(10^(2n) / n^2)
def concatenatePrimeSetSumBrute(n):
    primes = [3]
    concatenatePrimes = {}
    primeSets = {}
    
    for p in range(2, n+1):
        primeSets[p] = []
    
    prime1 = 7
    
    while True:
        if isPrime(prime1):
            primes.append(prime1)
            concatenatePrimes[prime1] = []
            
            for j in range(len(primes)-1):
                prime2 = primes[j]
                
                newPrime1 = int(str(prime1) + str(prime2))
                newPrime2 = int(str(prime2) + str(prime1))
                
                if isPrime(newPrime1) and isPrime(newPrime2):
                    concatenatePrimes[prime1].append(prime2)
                    primeSets[2].append([prime2, prime1])
                    
            for p in range(2, n+1):
                if len(primeSets[p]) == 0:
                    break
                
                for primeSet in primeSets[p]:
                    if set(primeSet).issubset(concatenatePrimes[prime1]):
                        primeSets[p+1].append(primeSet + [prime1])
                
            if len(primeSets[n]) == 1:
                return sum(primeSets[n][0])
            
        
        if int(str(prime1)[-1]) == 3:
            prime1 += 4
        else:
            prime1 += 2
    
    return None

# Time O(sqrt(n)), Space O(1)
def isPrime(n):
    if n <= 1:
        return False

    for i in range(2, int(math.sqrt(n)) + 1):
        if n % i == 0:
            return False

    return True

# Time: O(C(P, n-1) * n^2 + P^2 * 10^n), Space: O(10^n + P^2)
# Given P ≈ 10^n / n
def concatenatePrimeSetSum(n):
    primes = [3]
    concatenatePrimes = {}
    
    prime1 = 7
    
    while True:
        if isPrime(prime1):
            primes.append(prime1)
            concatenatePrimes[prime1] = []
            
            for j in range(len(primes)-1):
                prime2 = primes[j]
                
                newPrime1 = int(str(prime1) + str(prime2))
                newPrime2 = int(str(prime2) + str(prime1))
                
                if isPrime(newPrime1) and isPrime(newPrime2):
                    concatenatePrimes[prime1].append(prime2)
                    
            if len(concatenatePrimes[prime1]) >= n-1:
                for subset in combinations(concatenatePrimes[prime1], n-1):
                    valid = True

                    for i in range(len(subset)):
                        prime = subset[i]

                        for otherPrime in subset[:i]:
                            if otherPrime not in concatenatePrimes[prime]:
                                valid = False
                                break

                        if not valid:
                            break

                    if valid:
                        return sum(subset) + prime1
        
        if int(str(prime1)[-1]) == 3:
            prime1 += 4
        else:
            prime1 += 2
        
    return None


print(concatenatePrimeSetSumBrute(4))
print(concatenatePrimeSetSum(4))

print(concatenatePrimeSetSumBrute(5))
print(concatenatePrimeSetSum(5))
