import math
"""
The sequence of triangle numbers is generated by adding the natural numbers. So the 7th triangle number would be 1 + 2 + 3 + 4 + 5 + 6 + 7 = 28

The first ten terms would be 1, 3, 6, 10, 15, 21, 28, 36, 45, 55, ...

Let us list the factors of the first seven triangle numbers:
1: 1
3: 1, 3
6: 1, 2, 3, 6
10: 1, 2, 5, 10
15: 1, 3, 5, 15
21: 1, 3, 7, 21
28: 1, 2, 4, 7, 14, 28

We can see that 28 is the first triangle number to have over five divisors.
What is the value of the first triangle number to have over five hundred divisors?

ANSWER: 76576500
"""

# Time O(T), Space O(1)
# T = triangular number found
def highlyDivisibleTriangularNumberBrute(divisors):
    divisorsCurrent = 1
    triNum = 1
    i = 2
    
    while divisorsCurrent <= divisors:
        triNum += i
        divisorsCurrent = divisorsCount(triNum)
        
        i += 1
    
    return triNum
    
    
# Time O(N^(1/2)), Space O(1) given N = num
def divisorsCount(num):
    if num == 1:
        return 1
    
    divisorsCount = 2
    sqrtNum = int(math.sqrt(num))
    
    for i in range(2, sqrtNum+1):
        if i**2 == num:
            divisorsCount += 1
        elif num % i == 0:
            divisorsCount += 2
    
    return divisorsCount

# Time O(T^(3/2)), Space O(1)
# T = triangular number found
def highlyDivisibleTriangularNumberPrime(divisors):
    divisorsCurrent = 1
    triNum = 1
    i = 2
    
    while divisorsCurrent <= divisors:
        triNum += i
        divisorsCurrent = divisorsCountPrime(triNum)
        i += 1
            
    return triNum

# Time O(N), Space O(1) given N = num
def divisorsCountPrime(num):
    divisorsCount = 1
    exponent = 0
    
    while num % 2 == 0:
        exponent += 1
        num //= 2
    
    divisorsCount *= (exponent+1)
    factor = 3
    
    while 1 < num and factor <= num:
        if num % factor == 0:
            exponent = 0
            while num % factor == 0:
                exponent += 1
                num //= factor
            divisorsCount *= (exponent+1)
        factor += 2
        
    return divisorsCount

# Time O(T), Space O(1)
# T = triangular number found
def highlyDivisibleTriangularNumberSumFormula(divisors):
    divisorsCurrent = 1
    i = 1
    
    while divisorsCurrent <= divisors:
        i += 1
        
        if i % 2 == 0:
            d1 = divisorsCountPrime(i//2)
            d2 = divisorsCountPrime(i+1)
        else:
            d1 = divisorsCountPrime(i)
            d2 = divisorsCountPrime((i+1)//2)
        
        divisorsCurrent = d1 * d2
        
    return (i*(i+1))//2


print(highlyDivisibleTriangularNumberBrute(5))
print(highlyDivisibleTriangularNumberPrime(5))
print(highlyDivisibleTriangularNumberSumFormula(5))

print(highlyDivisibleTriangularNumberBrute(500))
print(highlyDivisibleTriangularNumberPrime(500))
print(highlyDivisibleTriangularNumberSumFormula(500))
