"""
Take the number 192 and multiply it by each of 1, 2, and 3:
192 × 1 = 192
192 × 2 = 384
192 × 3 = 576

By concatenating each product we get the 1 to 9 pandigital number, 192384576. We will call 192384576 the concatenated product of 192 and (1,2,3).
The same can be achieved by starting with 9 and multiplying by 1, 2, 3, 4, and 5, giving the pandigital number 918273645, which is the concatenated product of 9 and (1,2,3,4,5).

What is the largest 1 to 9 pandigital 9-digit number that can be formed as the concatenated product of an integer with (1,2,…,n) where n > 1?

ANSWER: 932718654
"""

# Time: O(n * 10^(n/2)), Space: O(n)
def largestNPandigitalMultiple(n):
    if 10 <= n:
        return None
    if n == 1:
        return 1
    
    digits = set("123456789"[:n])
    
    if n % 2 == 0:
        limit = 5 * 10 ** (n//2 - 1)
    else:
        limit = 10 ** ((n-1)//2)
        
    for i in range(limit-1, 0, -1):
        pandigital = str(i)
        used = set(pandigital)
        
        if '0' in used or len(used) != len(pandigital):
            continue
        
        j = 2
        while len(pandigital) < n:
            newPiece = str(j * i)

            if '0' in newPiece or (used & set(newPiece)):
                break

            used.update(newPiece)
            pandigital += newPiece
            j += 1
            
        if set(pandigital) == digits and len(pandigital) == n:
            return int(pandigital)


print(largestNPandigitalMultiple(9))
