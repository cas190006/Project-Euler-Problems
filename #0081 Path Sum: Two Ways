"""
In the 5 by 5 matrix below, the minimal path sum from the top left to the bottom right, by only moving to the right and down, is indicated in bold and is equal to 2427.

*131*  673  234   103    18
*201* *96* *342*  965   150
 630   803 *746* *422*  111
 537   699  497  *121*  956
 805   732  524  *37* *331*

Find the minimal path sum from the top left to the bottom right by only moving right and down in matrix.txt, a 31K text file containing an 80 by 80 matrix.

ANSWER: 427337
"""

# Time: O(rows * cols), Space: O(rows * cols)
def minPathSum(matrix):
    rows = len(matrix)
    cols = len(matrix[0])
    minPathMatrix = [row[:] for row in matrix]

    for col in range(1, cols):
        minPathMatrix[0][col] += minPathMatrix[0][col-1]

    for row in range(1, rows):
        minPathMatrix[row][0] += minPathMatrix[row-1][0]

    for row in range(1, rows):
        for col in range(1, cols):
            minPathMatrix[row][col] += min(minPathMatrix[row-1][col], minPathMatrix[row][col-1])

    return minPathMatrix[rows-1][cols-1]

# Time: O(rows * cols), Space: O(cols)
def minPathSumRow(matrix):
    rows = len(matrix)
    cols = len(matrix[0])

    minPath = [0] * cols

    for row in range(rows):
        for col in range(cols):
            if row == 0 and col == 0:
                minPath[col] = matrix[row][col]
            elif row == 0:
                minPath[col] = minPath[col-1] + matrix[row][col]
            elif col == 0:
                minPath[col] = minPath[col] + matrix[row][col]
            else:
                minPath[col] = min(minPath[col], minPath[col-1]) + matrix[row][col]

    return minPath[-1]


with open('matrix.txt', 'r') as file:
    matrix = [list(map(int, row.split(","))) for row in file.read().split('\n')[:-1]]

testMatrix = [
    [131, 673, 234, 103, 18],
    [201,  96, 342, 965, 150],
    [630, 803, 746, 422, 111],
    [537, 699, 497, 121, 956],
    [805, 732, 524,  37, 331]
]

print(minPathSum(testMatrix))
print(minPathSumRow(testMatrix))

print(minPathSum(matrix))
print(minPathSumRow(matrix))
