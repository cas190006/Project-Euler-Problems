import math
"""
Starting in the top left corner of a 2 * 2 grid, and only being able to move to the right and down, there are exactly 6 routes to the bottom right corner.

How many such routes are there through a 20 * 20 grid?

ANSWER: 137846528820
"""

# Time O(nm), Space O(nm)
def latticePathsNbyM(n, m):
    grid = [[0 for _ in range(n+1)] for _ in range(m+1)]
    
    for i in range(n+1):
        grid[i][0] = 1
    
    for i in range(m+1):
        grid[0][i] = 1
        
    for i in range(1, n+1):
        for j in range(1, m+1):
            grid[i][j] = grid[i-1][j] + grid[i][j-1]
    
    return grid[n][m]

# Time O(n^2), Space O(n^2)
def latticePathsNbyN(n):
    grid = [[0 for _ in range(n+1)] for _ in range(n+1)]
    
    for i in range(n+1):
        grid[i][0] = 1
        grid[0][i] = 1
        
    for i in range(1, n+1):
        for j in range(1, n+1):
            grid[i][j] = grid[i-1][j] + grid[i][j-1]
    
    return grid[n][n]

# Time O(1), Space O(1)
def latticePathsFormulaNbyM(n, m):
    return math.comb(n+m, n)

# Time O(1), Space O(1)
def latticePathsFormulaNbyN(n):
    return math.comb(2*n, n)


print(latticePathsNbyM(2, 2)) 
print(latticePathsNbyN(2))
print(latticePathsFormulaNbyM(2, 2)) 
print(latticePathsFormulaNbyN(2)) 

print(latticePathsNbyM(20, 20))
print(latticePathsNbyN(20))
print(latticePathsFormulaNbyM(20, 20))
print(latticePathsFormulaNbyN(20))
