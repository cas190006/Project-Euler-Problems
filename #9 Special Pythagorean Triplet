import math
"""
A Pythagorean triplet is a set of three natural numbers, a < b < c, for which,
a^2 + b^2 = c^2.

For example, 3^2 + 4^2 = 9 + 16 = 25 = 5^2.

There exists exactly one Pythagorean triplet for which a + b + c = 1000.
Find the product abc.

ANSWER: 31875000
"""

# Time O(n^2), Space O(1)
def specialPythagoreanTripletBrute(n):
    for i in range(3, ((n-3) // 3) + 1):
        for j in range(i+1, ((n-1-i) // 2) + 1):
            k = n - i - j
        
            if (i*i + j*j) == k*k:
                return i * j * k
            
# Time O(N), Space O(1)
# Given N = num
def specialPythagoreanTripletmnk(num):
    halfNum = num // 2
    mLimit = math.ceil(math.sqrt(halfNum))
    
    for m in range(2, mLimit):
        if halfNum % m == 0:
            kLimit = halfNum // m
            
            if m % 2 == 0:
                kStart = m+1
            else:
                kStart = m+2
                
                
            for k in range(kStart, kLimit+1, 2):
                if k >= 2*m:
                    break
                
                if kLimit % k == 0 and math.gcd(m,k) == 1:
                    d = halfNum//(m*k)
                    n = k-m
                    a = d * (m*m - n*n)
                    b = 2*d*m*n
                    c = d * (m*m + n*n)
                    
                    return a * b * c


print(specialPythagoreanTripletBrute(12))
print(specialPythagoreanTripletmnk(12))

print(specialPythagoreanTripletBrute(1000))
print(specialPythagoreanTripletmnk(1000))
