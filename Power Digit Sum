"""
2^15 = 32768 and the sum of its digits is 3 + 2 + 7 + 6 + 8 = 26.

What is the sum of the digits of the number 2^1000?

ANSWER: 1366
"""

# Time O(n), Space O(1)
def powerDigitSum(n):
    product = 2**n
    
    total = 0
    
    while product > 0:
        digit = product % 10
        total += digit
        product = product // 10
    
    return total


print(powerDigitSum(15))
print(powerDigitSum(1000))
